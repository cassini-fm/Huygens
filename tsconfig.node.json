{
    "include": [
        "electron.vite.config.*",
        "vitest.config.*",
        "src/**/*",
        "src/preload/**/*",
        "src/shared/**/*",
    ],
    "compilerOptions": {
        "target": "es2025",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "types": ["node"],
        "composite": true
    }
}
